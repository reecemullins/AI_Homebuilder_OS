{
  "name": "builderos",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate --filter=@builderos/database",
    "db:push": "turbo run db:push --filter=@builderos/database",
    "db:migrate": "turbo run db:migrate --filter=@builderos/database",
    "start:api": "turbo run start --filter=@builderos/api",
    "start:web": "turbo run start --filter=@builderos/web",
    "start:worker": "turbo run start:worker --filter=@builderos/api"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0"
}
